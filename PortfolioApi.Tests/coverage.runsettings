<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for coverlet; see "Testen" in the README for the command.
  Measures the API's own code only:
  - Include: only the PortfolioApi assembly, not the tests or the packages.
  - ExcludeByFile: the EF Core migrations. They are generated by "dotnet ef migrations add" and contain
    no logic of mine; the tests build their SQLite database from the model instead of running them.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[PortfolioApi]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
